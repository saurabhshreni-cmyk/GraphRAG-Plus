# Copy to .env (project root) and override as needed.
# Core pipeline vars are prefixed GRAPHRAG_; integration vars are unprefixed.

# --- Integrations (put real values in the root .env — NEVER commit secrets) --
# NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
# NEO4J_USERNAME=<username>
# NEO4J_PASSWORD=<password>
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# REASONING_MODEL=deepseek-r1:8b

# --- Tuning knobs (defaults shown) -------------------------------------------
# GRAPHRAG_LLM_EXTRACTION=1                # 0 = spaCy-only extraction
# GRAPHRAG_LLM_EXTRACTION_MAX_CHUNKS=8     # LLM budget per ingest
# GRAPHRAG_LLM_EXTRACTION_TIMEOUT_S=120    # per-chunk LLM extraction timeout
# GRAPHRAG_REASONING_VERIFIER=1            # 0 = skip DeepSeek R1 verification
# GRAPHRAG_VERIFIER_TIMEOUT_S=60           # raise to 150 on laptop hardware
# GRAPHRAG_ENTITY_RESOLUTION=1             # 0 = skip Neo4j entity dedup
# OLLAMA_TIMEOUT_S=30                      # answer generation timeout (90 on 16GB RAM)

# Feature flags
GRAPHRAG_ENABLE_CALIBRATION=true
GRAPHRAG_ENABLE_CONTRADICTION=true
GRAPHRAG_ENABLE_ACTIVE_LEARNING=true
GRAPHRAG_ANALYST_MODE_DEFAULT=false

# Backends / ablation flags
GRAPHRAG_USE_GNN=true
GRAPHRAG_USE_CALIBRATION=true
GRAPHRAG_USE_GRAPH=true
GRAPHRAG_USE_VECTOR=true
GRAPHRAG_USE_TRUST=true

# Thresholds
GRAPHRAG_EXTRACTION_THRESHOLD=0.6
GRAPHRAG_ANSWER_THRESHOLD=0.7
GRAPHRAG_HIGH_UNCERTAINTY_THRESHOLD=0.55

# Reproducibility
GRAPHRAG_RANDOM_SEED=42

# Paths
GRAPHRAG_CACHE_DIR=graphrag_plus/.cache
GRAPHRAG_TEMP_DIR=graphrag_plus/.cache/tmp
GRAPHRAG_OUTPUTS_DIR=graphrag_plus/data/outputs
GRAPHRAG_RUN_LOGS_PATH=graphrag_plus/data/run_logs.jsonl

# Scoring weights
GRAPHRAG_SCORING_W1_SEMANTIC=0.22
GRAPHRAG_SCORING_W2_GRAPH=0.20
GRAPHRAG_SCORING_W3_CONFIDENCE=0.20
GRAPHRAG_SCORING_W4_TRUST=0.20
GRAPHRAG_SCORING_W5_UNCERTAINTY_PENALTY=0.18
