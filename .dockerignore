# Keep the build context small and the image lean. Mirrors .vercelignore plus
# local dev artefacts. The demo corpus is kept (a fresh boot seeds from it);
# other local corpora and runtime state are excluded.

# Local Python envs / caches
venv
.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
graphrag_plus/.cache
graphrag_plus/.tmp
*.egg-info
graphrag_plus/graphrag_plus.egg-info

# Frontend (deployed separately on Vercel)
frontend
_demo
graphify-out
graphrag_plus/graphify-out

# VCS / CI / editor / agent state
.git
.github
.claude
.codex-run
.vercel
.mypy_cache
.ruff_cache

# Tests, scripts, examples not needed at runtime
graphrag_plus/app/tests
graphrag_plus/scripts
graphrag_plus/examples

# Runtime state — only the committed demo corpus ships
graphrag_plus/data/outputs
graphrag_plus/data/reports
graphrag_plus/data/graph_versions
graphrag_plus/data/*.json
graphrag_plus/data/*.jsonl
graphrag_plus/data/corpora/*
!graphrag_plus/data/corpora/corpus_demo_nova

# Logs and docs
*.log
*.md
!deploy/DEPLOYMENT.md
